{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "eo-blocks/google-review-prompt",
  "version": "1.0.0",
  "title": "Google Review Prompt",
  "category": "eo-blocks",
  "icon": "feedback",
  "description": "A Call to Action block prompting users to leave a Google Review",
  "example": {},
  "attributes": {
    "message": {
      "type": "string",
      "default": "Laissez-nous votre avis sur Google"
    },
    "buttonText": {
      "type": "string",
      "default": "Évaluer"
    },
    "useApi": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "textdomain": "eo-blocks",
  "editorScript": "file:./index.js"
}